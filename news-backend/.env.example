# Port + who may call the API (your site origin, comma-separated; * for any)
PORT=4000
ALLOWED_ORIGINS=https://worldmonitorlive.app

# Supabase (persistence + Realtime). The ingester writes events here.
# URL + SERVICE ROLE key from Supabase → Project Settings → API.
# SERVICE_ROLE is a SECRET — server only, never in the front-end.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE=YOUR_SERVICE_ROLE_KEY

# Crypto news comes from free RSS feeds by default (no key). Add/replace feeds here:
CRYPTO_RSS=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss

# CryptoPanic is now a PAID API — leave empty and use the free RSS above.
# (Only set this if you have a paid CryptoPanic token.)
CRYPTOPANIC_TOKEN=

# USGS earthquake feed + minimum magnitude to show
# Feeds: all_hour / 2.5_hour / significant_day (https://earthquake.usgs.gov/earthquakes/feed/v1.0/geojson.php)
USGS_FEED=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_hour.geojson
USGS_MIN_MAG=2.5

# GDELT geolocated world-news query + time window
GDELT_QUERY=(protest OR clash OR strike OR election OR earthquake OR flood OR wildfire OR outage OR attack OR ceasefire)
GDELT_TIMESPAN=30min

# Markets (optional): free token from https://finnhub.io/  (leave empty to skip markets)
FINNHUB_TOKEN=

# AI/tech via Hacker News (no key). Tune what counts as an AI story:
AI_QUERY=AI OR "artificial intelligence" OR LLM OR OpenAI OR chatbot OR "machine learning"

# How many events to keep in memory
BUFFER_MAX=500
