# --- Stripe keys ---
# Secret key: Stripe Dashboard → Developers → API keys (use sk_test_... while testing)
STRIPE_SECRET_KEY=sk_test_xxx

# Webhook signing secret: Stripe Dashboard → Developers → Webhooks → your endpoint
# (or `stripe listen` gives you a whsec_... when testing locally)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Recurring Price IDs (one per interval) ---
# Create a Product in Stripe with three recurring prices:
#   weekly  = every 1 week
#   monthly = every 1 month
#   yearly  = every 1 year
# Copy each price id (price_...) here:
STRIPE_PRICE_WEEKLY=price_xxx_weekly
STRIPE_PRICE_MONTHLY=price_xxx_monthly
STRIPE_PRICE_YEARLY=price_xxx_yearly

# --- Redirect URLs after checkout (your site) ---
SUCCESS_URL=https://www.worldmonitor.app/success
CANCEL_URL=https://www.worldmonitor.app/pricing

# --- CORS: which front-end origins may call this API (comma-separated) ---
# e.g. https://www.worldmonitor.app,https://worldmonitor.app
ALLOWED_ORIGINS=https://www.worldmonitor.app

PORT=3000
